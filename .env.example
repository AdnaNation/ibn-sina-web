# Copy to .env.local for local development.
# Never commit real credentials or production secrets.

MONGODB_URI=
MONGODB_DB=

# Use a randomly generated secret with at least 32 characters.
ADMIN_SECRET=

# Main Admin password. Set a strong, unique value outside source control.
ADMIN_PASSWORD=

# Keep public booking disabled in an independent demo.
ENABLE_PUBLIC_BOOKING=false

# Synthetic presentation data only; keep disabled in production.
ENABLE_DEMO=false
