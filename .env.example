# Copy to .env.local for local development.
# Never commit real credentials or production secrets.

MONGODB_URI=
MONGODB_DB=

# Use a randomly generated secret with at least 32 characters.
ADMIN_SECRET=

# Main Admin password. Set a strong, unique value outside source control.
ADMIN_PASSWORD=

# Real public booking requires explicit institutional authorization.
ENABLE_PUBLIC_BOOKING=false
ENABLE_PUBLIC_CANCELLATION=false

# Set true only for a fictional-data demo using a separate, disposable demo database.
# This enables demo appointment submissions; it does not authorize real patient bookings.
ENABLE_DEMO=false
