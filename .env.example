# Copy to .env.local for local development.
# Never commit real credentials or production secrets.

MONGODB_URI=
MONGODB_DB=

# Use a randomly generated secret with at least 32 characters.
ADMIN_SECRET=

# Main Admin password. Set a strong, unique value outside source control.
ADMIN_PASSWORD=

# Demo workflow: public booking and self-service cancellation are enabled.
# Set either value to false to disable that public feature.
ENABLE_PUBLIC_BOOKING=true
ENABLE_PUBLIC_CANCELLATION=true

# Optional: show existing-data presentation shortcuts on the Main Admin dashboard.
# This does not create or reset data.
ENABLE_DEMO=false

# Search indexing is intentionally disabled for this independent prototype.
# Only enable after institutional authorization, verified public content,
# and configuration of NEXT_PUBLIC_SITE_URL to the approved HTTPS domain.
ENABLE_SEARCH_INDEXING=false
NEXT_PUBLIC_SITE_URL=
