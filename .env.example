# Copy to .env.local for local development.
# Never commit real credentials or production secrets.

MONGODB_URI=
MONGODB_DB=

# Use a randomly generated secret with at least 32 characters.
ADMIN_SECRET=

# Main Admin password. Set a strong, unique value outside source control.
ADMIN_PASSWORD=

# Public booking and self-service cancellation require separate explicit authorization.
# Keep both disabled for an authority demonstration.
ENABLE_PUBLIC_BOOKING=false
ENABLE_PUBLIC_CANCELLATION=false

# Optional: show existing-data presentation shortcuts on the Main Admin dashboard.
# This does not create/reset data or enable public booking/cancellation.
ENABLE_DEMO=false
